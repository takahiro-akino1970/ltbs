APP_NAME="LTBS 発注"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://order.example.jp

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=db.example.com
DB_PORT=3306
DB_DATABASE=ltbs
DB_USERNAME=ltbs_app
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=file
SESSION_COOKIE=ltbs_order_session
SESSION_DOMAIN=order.example.jp
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120

CACHE_STORE=file
CACHE_PREFIX=ltbs-order-cache-
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
